---
import { ArrowUpRight } from "lucide-react";

import { cases, products } from "@/data/content";
---

<section id="productos" class="relative bg-ink py-24 lg:py-32">
  <div class="container-shell">
    <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <div>
        <p class="section-kicker">Productos</p>
        <h2 class="mt-5 max-w-2xl text-4xl leading-tight font-semibold tracking-[-0.04em] sm:text-5xl">
          Tecnología lista para generar valor.
        </h2>
      </div>
      <p class="max-w-sm leading-7 text-white/55">
        Soluciones que responden a desafíos concretos de negocio, talento y experiencia de cliente.
      </p>
    </div>

    <div class="mt-14 flex snap-x gap-5 overflow-x-auto pb-5">
      {
        products.map((product, index) => (
          <article class="group min-w-[82vw] snap-start overflow-hidden rounded-3xl border border-white/10 bg-navy sm:min-w-[25rem] lg:min-w-[29rem]">
            <div class="flex aspect-[16/9] items-center justify-center overflow-hidden bg-white p-10">
              <img
                src={product.image}
                alt={`Logo de ${product.name}`}
                loading="lazy"
                class="max-h-28 max-w-[75%] object-contain transition duration-500 group-hover:scale-105"
              />
            </div>
            <div class="p-7">
              <span class="text-xs font-extrabold tracking-[0.18em] text-sky uppercase">
                Producto {String(index + 1).padStart(2, "0")}
              </span>
              <h3 class="mt-3 text-2xl font-bold">{product.name}</h3>
              <p class="mt-3 max-w-md text-sm leading-6 text-white/55">{product.description}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section id="casos" class="bg-ocean py-24 lg:py-32">
  <div class="container-shell">
    <div class="max-w-3xl">
      <p class="section-kicker">Casos de éxito</p>
      <h2 class="mt-5 text-4xl leading-tight font-semibold tracking-[-0.04em] sm:text-5xl">
        Ideas que se convirtieron en experiencias reales.
      </h2>
    </div>

    <div class="mt-14 grid gap-6 lg:grid-cols-3">
      {
        cases.map((item) => (
          <article class="group overflow-hidden rounded-3xl bg-mist text-ink">
            <div class="relative aspect-[4/3] overflow-hidden bg-white">
              <img
                src={item.image}
                alt={`Logo de ${item.name}`}
                loading="lazy"
                class="size-full object-cover transition duration-500 group-hover:scale-105"
              />
              <span class="absolute right-5 top-5 grid size-11 place-items-center rounded-full bg-ink text-white transition group-hover:bg-leaf group-hover:text-ink">
                <ArrowUpRight size={20} />
              </span>
            </div>
            <div class="p-7">
              <span class="text-xs font-extrabold tracking-[0.15em] text-ocean uppercase">
                {item.category}
              </span>
              <h3 class="mt-3 text-3xl font-bold">{item.name}</h3>
              <p class="mt-4 text-sm leading-6 text-ink/60">{item.description}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
