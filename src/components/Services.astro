---
import {
  BrainCircuit,
  Code2,
  Headphones,
  MonitorSmartphone,
  Rocket,
  Search,
  ShieldCheck,
  Users,
} from "lucide-react";

import { services } from "@/data/content";

const icons = {
  brain: BrainCircuit,
  code: Code2,
  devices: MonitorSmartphone,
  headphones: Headphones,
  rocket: Rocket,
  search: Search,
  shield: ShieldCheck,
  users: Users,
};
---

<section id="servicios" class="relative overflow-hidden bg-mist py-24 text-ink lg:py-32">
  <div class="absolute right-0 top-0 size-80 translate-x-1/3 -translate-y-1/3 rounded-full border-[60px] border-wave/10"></div>
  <div class="container-shell relative">
    <div class="grid gap-8 lg:grid-cols-[.85fr_1.15fr] lg:gap-20">
      <div>
        <p class="section-kicker">Lo que hacemos</p>
        <h2 class="mt-5 max-w-lg text-4xl leading-tight font-semibold tracking-[-0.04em] sm:text-5xl">
          Un equipo, múltiples capacidades.
        </h2>
        <p class="mt-6 max-w-md leading-7 text-ink/60">
          Combinamos estrategia, diseño e ingeniería para acompañar cada etapa de un producto
          digital.
        </p>
      </div>

      <div class="grid sm:grid-cols-2">
        {
          services.map((service, index) => {
            const Icon = icons[service.icon];
            return (
              <article class="group border-b border-ink/15 py-7 sm:px-7 sm:odd:border-r">
                <div class="mb-8 flex items-center justify-between">
                  <span class="grid size-12 place-items-center rounded-xl bg-wave/10 text-ocean transition group-hover:bg-ocean group-hover:text-white">
                    <Icon size={24} strokeWidth={1.8} />
                  </span>
                  <span class="font-display text-sm font-bold text-ink/30">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                </div>
                <h3 class="text-xl font-bold">{service.title}</h3>
                <p class="mt-3 text-sm leading-6 text-ink/55">{service.description}</p>
              </article>
            );
          })
        }
      </div>
    </div>
  </div>
</section>
